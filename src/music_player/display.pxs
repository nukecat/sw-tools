# MIDI music player screen (generated by sw-tools)
#
# Input  A      : the play switch. On = the song is playing, off = back to the start.
# Inputs B, C.. : one per pitch, lowest pitch first. 1 while that key is down. They come from the
#                 OR gates in front of the tone generators, so the screen shows what you hear.
#
# Shows the title, the keys that are down (as a keyboard strip and as note names), the time
# played and a progress bar. Only what changed is redrawn; the screen keeps its pixels between
# ticks.

# MIDI key number behind each of the inputs B, C..
data pitches = [@PITCHES@]
# 1 for the black keys of an octave, C first
data sharps = [0, 1, 0, 1, 0, 0, 1, 0, 1, 0, 1, 0]

static elapsed = 0     # milliseconds played so far
static ui_ready = 0    # 0 until the fixed parts of the screen are drawn
static shown = []      # 1 while a key is drawn as down, one entry per key
static shown_w = 0     # progress bar pixels drawn so far
static shown_s = 0     # whole seconds currently shown (set to -1 on first draw)

keys = @KEYS@
total_ms = @TOTAL_MS@
repeat = @REPEAT@
low = pitches[0]
span = pitches[keys - 1] - low + 1
bg = rgb(10, 10, 24)
changed = 0

if len(shown) != keys:
    resize(shown, keys)

# Time runs while the switch is on, the way the microcontrollers that play the song count it.
if A > 0.5:
    elapsed += dt * 1000
    if elapsed >= total_ms:
        if repeat == 1:
            elapsed -= total_ms
        else:
            elapsed = total_ms
else:
    elapsed = 0

for k in range(keys):
    v = 1 if in(k + 1) > 0.5 else 0
    if v != shown[k]:
        shown[k] = v
        changed = 1

def mmss(ms) -> str:
    whole = floor(max(ms, 0) / 1000)
    sec = whole % 60
    return str(whole // 60, 0) + ":" + ("0" if sec < 10 else "") + str(sec, 0)

# The keys sit where their pitch is: one strip from the lowest to the highest pitch of the song.
# Every key of the song is drawn, dark when it is up and in the colour of its note when down.
def draw_keys(top, rows):
    for j in range(keys):
        p = pitches[j]
        x0 = floor((p - low) * width / span)
        x1 = floor((p + 1 - low) * width / span)
        w = x1 - x0
        if w > 2:
            w -= 1
        if shown[j] > 0:
            color(hsv((p % 12) * 30, 0.85, 1))
        else:
            color(18, 18, 40)
        fill_rect(x0, top, max(w, 1), rows)

# Names of the keys that are down, lowest first, like "C4 E4 G4".
def draw_names(y):
    color(bg)
    fill_rect(0, y, width, 5)
    s = ""
    for j in range(keys):
        if shown[j] > 0 and len(s) < 200:
            p = pitches[j]
            pc = p % 12
            s = s + sub("CCDDEFFGGAAB", pc, 1) + ("#" if sharps[pc] == 1 else "") + str(p // 12 - 1, 0) + " "
    color(255, 220, 120)
    text(1, y, s)

set_font(0)

if ui_ready == 0:
    ui_ready = 1
    shown_w = 0
    shown_s = -1
    changed = 1
    clear(bg)
    color(110, 190, 255)
    text(1, 1, "@TITLE@")
    color(32, 32, 52)
    fill_rect(0, height - 2, width, 2)

# Capped so a full redraw stays far below the 500,000 operation budget even on huge screens.
if changed == 1:
    if height >= 40:
        draw_keys(8, min(height - 24, 64))
        draw_names(height - 14)
    elif height >= 22:
        draw_keys(8, min(height - 18, 64))

cur_s = floor(max(elapsed, 0) / 1000)
if cur_s != shown_s:
    shown_s = cur_s
    color(bg)
    fill_rect(0, height - 8, width, 5)
    color(200, 200, 220)
    text(1, height - 8, mmss(elapsed) + "/" + mmss(total_ms))

fw = 0
if total_ms > 0:
    fw = floor(clamp(elapsed / total_ms, 0, 1) * width)
if fw != shown_w:
    if fw < shown_w:
        color(32, 32, 52)
        fill_rect(0, height - 2, width, 2)
        shown_w = 0
    if fw > shown_w:
        color(0, 220, 140)
        fill_rect(shown_w, height - 2, fw - shown_w, 2)
    shown_w = fw
