# MIDI music player (generated by sw-tools)
#
# Input  A : on = play, off = stop and rewind
# Outputs  : one per pitch, lowest pitch first. 1 = key down, 0 = key up.
#            Wire each output to a tone generator.
#
# @IF chain@
# A long song is split in time over several of these controllers, chained one after another.
# Each plays its part of the song and, when it is over, tells the next one to start (every wire
# costs one tick, which the tables allow for). The outputs of all controllers go through OR gates
# before they reach the tone generators.
# @END@
# song: 3 bytes per event
#   byte 0-1 : milliseconds to wait before this event (little endian)
#   byte 2   : (key << 1) | on, or 255 for "only wait"
data song = [@SONG@]
# @IF chain@
data key_ids = [@KEY_IDS@]
# @END@

static cursor = 0      # next event to play
static wait = 0        # milliseconds until that event
static elapsed = 0     # milliseconds since playback started
# @IF chain@
static state = 0       # 0 waiting, 1 playing, 2 part over (keys still held), 3 part over
# @ELSE@
static state = 0       # 0 stopped, 1 playing, 2 finished
# @END@
static held = []       # 1 while a key is down, one entry per output

keys = @KEYS@
total_ms = @TOTAL_MS@
repeat = @REPEAT@
n_events = len(song) // 3
changed = 0
# @IF chain@
has_link = @HAS_LINK@     # 1: tell the next controller (or, for the last one, the first) when done
restarts = @RESTARTS@     # 1: input B is the last controller, which says the song is over
# @END@

def delay(i) -> num:
    return song[i * 3] + song[i * 3 + 1] * 256

if len(held) != keys:
    resize(held, keys)

# @IF chain@
run = A > 0.5
if run:
    if state == 3 and restarts == 1 and B > 0.5:
        state = 0
    if state == 0:
        state = 1
        cursor = 0
        wait = delay(0)
        elapsed = 0
    if state == 2:
        # One tick after the hand-over: let go of the keys. The next controller has pressed the
        # ones that continue, and the OR gates keep those down.
        fill(held, 0)
        changed = 1
        state = 3
    elif state == 1:
        step_ms = dt * 1000
        wait -= step_ms
        elapsed += step_ms
        n = 0
        while n < 400:
            if cursor >= n_events:
                state = 2
                break
            if wait > 0:
                break
            v = song[cursor * 3 + 2]
            if v != 255:
                held[v >> 1] = v & 1
                changed = 1
            cursor += 1
            if cursor < n_events:
                wait += delay(cursor)
            n += 1
elif state != 0:
    state = 0
    cursor = 0
    elapsed = 0
    fill(held, 0)
    changed = 1

# @ELSE@
if A > 0.5:
    if state == 0:
        state = 1
        cursor = 0
        wait = delay(0)
        elapsed = 0
    if state == 1:
        step_ms = dt * 1000
        wait -= step_ms
        elapsed += step_ms
        n = 0
        # The cap only matters if the game stalls for a very long time.
        while n < 400:
            if cursor >= n_events:
                if repeat == 0:
                    state = 2
                    elapsed = total_ms
                    fill(held, 0)
                    changed = 1
                    break
                # wrap around, carrying over the overshoot so the loop never drifts
                cursor = 0
                wait += delay(0)
                elapsed -= total_ms
                fill(held, 0)
                changed = 1
            if wait > 0:
                break
            v = song[cursor * 3 + 2]
            if v != 255:
                held[v >> 1] = v & 1
                changed = 1
            cursor += 1
            if cursor < n_events:
                wait += delay(cursor)
            n += 1
elif state != 0:
    state = 0
    cursor = 0
    elapsed = 0
    fill(held, 0)
    changed = 1

# @END@
# Outputs are rewritten every tick so they never depend on slots persisting.
for k in range(keys):
    out(k + 1, held[k])
# @IF chain@
if has_link == 1:
    out(keys + 1, state >= 2)
# @END@
